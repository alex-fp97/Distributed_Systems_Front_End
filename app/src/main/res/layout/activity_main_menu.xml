<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/background_main_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Hamburger button -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="TODO"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <GridLayout
            android:id="@+id/gamesGrid"
            android:layout_width="391dp"
            android:layout_height="656dp"

            android:columnCount="2"
            android:padding="16dp"
            android:rowCount="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/slotsButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:contentDescription="@string/slots"
                android:foreground="@drawable/slots_button"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <ImageButton
                android:id="@+id/rouletteButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:contentDescription="@string/roulette"
                android:foreground="@drawable/roulette_button"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <ImageButton
                android:id="@+id/blackjackButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:contentDescription="Blackjack"
                android:foreground="@drawable/blackjack_button"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <ImageButton
                android:id="@+id/tomeButton"
                android:layout_width="4dp"
                android:layout_height="7dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:contentDescription="Tome of Madness"
                android:scaleType="center"
                android:src="@drawable/tome_of_sadness_img" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"/>

</androidx.drawerlayout.widget.DrawerLayout>