<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/txt_rate_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate a Game"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#070707"
        android:layout_marginBottom="24dp" />

    <!-- Select Game -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a Game:"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_games"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:background="#F5F5F5" />

    <!-- Rating Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Rating:"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <!-- Rating Bar (0-5 stars) -->
    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:rating="0"
        android:stepSize="1"
        android:layout_marginBottom="8dp"
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:layout_gravity="center_horizontal" />

    <!-- Display Current Rating -->
    <TextView
        android:id="@+id/txt_rating_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rating: 0/5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFD15A"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="32dp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Comments Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comments (Optional):"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_comments"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Share your thoughts about the game..."
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="24dp"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="12dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#070707"
            android:textColor="@android:color/white" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btn_submit_rating"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Submit Rating"
            android:backgroundTint="#FFD15A"
            android:textColor="#070707"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

